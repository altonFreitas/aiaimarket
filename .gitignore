# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template, which carries no secrets and is the one file that
# tells a new deploy which variables exist at all. `.env*` above swallowed it,
# so it was never committed -- and DEPLOY.md told you to copy a file that was
# not in the repo.
!.env.example

# vercel
.vercel

# apply-script backups (the --revert flags read these). Round 2 added
# .payments-backup to the ESLint ignores but not here, so it ended up
# committed -- untrack it with:  git rm -r --cached .payments-backup
.audit-backup/
.payments-backup/
# The apply scripts themselves are one-shot tools, not part of the app.
Apply*.js

# typescript
*.tsbuildinfo
next-env.d.ts
.v*-backup/
.marketplace-v2-backup/
.sales-backup/
