
# ---------------------------------------------------------------------------
# Card payments — BNCTL / Mastercard acquiring
#
# Leave EVERY value below blank and card payment simply does not appear at
# checkout; the existing manual methods (cash, bank transfer, wallet, fiar)
# keep working exactly as before. Nothing here is required to run the store.
#
# >>> Before switching this on, get BNCTL's merchant integration pack and
# >>> confirm the values against it. The adapter in
# >>> src/lib/payments/providers/mpgs.ts is written against the Mastercard
# >>> Payment Gateway Services REST API, which is the usual shape for a bank
# >>> acquiring on the Mastercard network -- but it has NOT been verified
# >>> against BNCTL's own documentation.
# ---------------------------------------------------------------------------

# Which adapter to use. Only "bnctl" ships today.
# PAYMENT_PROVIDER=bnctl

# Gateway REST host, from BNCTL. No trailing slash.
# MPGS_HOST=https://bnctl.gateway.mastercard.com
# MPGS_MERCHANT_ID=
# MPGS_API_PASSWORD=
# MPGS_API_VERSION=100

# Shared secret used to verify webhook signatures (HMAC-SHA256 over the raw
# body). Without it the webhook endpoint refuses every request -- which is
# the correct default: an unverified webhook that marks orders paid is a
# "mark any order paid" endpoint for anyone who finds the URL.
# MPGS_WEBHOOK_SECRET=
# MPGS_SIGNATURE_HEADER=x-notification-signature

# The gateway's browser-facing origin, added to the Content-Security-Policy
# so the hosted payment page is allowed to load. Usually the same host as
# MPGS_HOST. Without this the payment page is blocked by CSP and the only
# clue is a browser console message your buyer will never read.
# PAYMENT_GATEWAY_ORIGIN=https://bnctl.gateway.mastercard.com

# Shown as the merchant name on the hosted payment page.
# NEXT_PUBLIC_STORE_NAME=Loja AIAI
